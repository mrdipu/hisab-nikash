    <string name="drive_setup_required_title">OAuth Setup Required</string>
    <string name="drive_unregistered_summary">This app build is not yet registered in Google Cloud Console for Google Drive OAuth. Register the Package Name and Signing SHA-1 below as an Android OAuth 2.0 Client ID, enable the Google Drive API, and add your Google account under OAuth Consent Screen Test Users.</string>
